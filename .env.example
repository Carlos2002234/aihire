# Local: correr `supabase start` y copiar los valores que imprime.
# Cloud: Project Settings > API en el dashboard de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API (server-only, /src/lib/ai)
ANTHROPIC_API_KEY=

# Resend (emails, server-only, /src/lib/email)
RESEND_API_KEY=
RESEND_FROM_EMAIL="HireFlow <notificaciones@hireflow.app>"

# URL pública de la app (para links dentro de los emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
